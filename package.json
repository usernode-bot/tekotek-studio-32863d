{
  "name": "usernode-app-template",
  "version": "1.0.0",
  "private": true,
  "description": "Homeroom app template",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind-input.css -o public/tailwind.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --outfile=public/app.js --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\""
  },
  "dependencies": {
    "@remotion/player": "^4.0.536",
    "@remotion/web-renderer": "^4.0.536",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "3.4.17"
  }
}
